@startuml
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 11
skinparam roundcorner 8
skinparam ArrowColor #4E5D78
skinparam ArrowThickness 1.5
skinparam ActivityBackgroundColor #FFFFFF
skinparam ActivityBorderColor #4E5D78
skinparam ActivityDiamondBackgroundColor #EEF3FF
skinparam ActivityDiamondBorderColor #3A4DB0

start

#E8F0FE:HBN-EEG Dataset (BIDS, multi-subject);

#DDEEFF:**Data Preparation**
Select subjects · Load CCD EEG
Parse events · Attach RT & Correctness labels
Construct CCD-ITI windows (prestimulus segments);

#D8EEF8:**Preprocessing**
Bandpass filter · Artifact removal
Epoch extraction · Normalization;

repeat
  #D8F0DC:**Verification**
  Compute SNR Spectra (20 / 25 Hz)
  Quality gate;
backward:Adjust parameters / Flag subjects;
repeat while (Acceptable signal quality?) is (no) not (yes)

fork
  #FFF4CC:**Task A — RT Regression**
  EEGNet · EEGNet-Compact
  Output: Reaction Time (ms);
fork again
  #FFF4CC:**Task B — Correctness Classification**
  EEGNet · EEGNet-Compact
  Output: Correct / Incorrect;
end fork

#FDEAEA:**Evaluation**
Regression: MAE, RMSE, R², Pearson r
Classification: Acc, Bal-Acc, Sens, Spec, F1, ROC-AUC;

#F0EAFF:Export artifacts (config · metrics · plots · checkpoint);

stop
@enduml
